# Package-specific substitution variables
package = @PACKAGE_NAME@
version = @PACKAGE_VERSION@
tarname = @PACKAGE_TARNAME@
libname = lib$(package).a

# Prefix-specific substitution variables
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@

# VPATH-specific substitution variables
srcdir = @srcdir@
VPATH = @srcdir@

# Terminal colors
RED=`tput setaf 1`
GREEN=`tput setaf 2`
RESET=`tput sgr0`

CFLAGS += -g -O0

.PHONY: all
all: testc test

TEST_OBJS = test.o
TESTC_OBJS = testc.o
GENTV_OBJS = generate-test-vectors.o

libdir = ../src
lib = $(libdir)/$(libname)

LDLIBS += -L$(libdir) -llifehash -lstdc++ -lm

$(lib):
	cd $(libdir) && $(MAKE) lib

test: $(lib) $(TEST_OBJS)
testc: $(lib) $(TESTC_OBJS)
generate-test-vectors: $(lib) $(GENTV_OBJS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(GENTV_OBJS) $(lib) -lm

.PHONY: generate-test-vectors-json
generate-test-vectors-json: generate-test-vectors
	./generate-test-vectors > test-vectors.json

.PHONY: check
check: test testc
	./test
	./testc
	@echo "$(GREEN)*** ALL TESTS PASSED ***$(RESET)"

.PHONY: clean
clean:
	rm -f test testc generate-test-vectors $(TEST_OBJS) $(TESTC_OBJS) $(GENTV_OBJS)
	rm -rf *.dSYM

.PHONY: distclean
distclean: clean
	rm -f Makefile
